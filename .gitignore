/data/
/models/
/results/
Raw_Data_*.csv
*.parquet
*.nc

# Reference material: copyrighted papers, private planning documents, style references
/papers/
/pdd_pages/
*.pdf

# Python
__pycache__/
*.pyc
.pytest_cache/
.ipynb_checkpoints/

# Credentials: never commit. Keys belong in Colab Secrets or local environment variables.
.env
.cdsapirc
*.token

# Agent/editor plugin installs (hundreds of MB, not part of the project)
.agents/
